{
  "name": "bottomuplabs-site",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "test:unit": "vitest run",
    "build": "astro build",
    "build:production": "astro build && node scripts/check-placeholders.mjs dist",
    "verify": "node scripts/check-placeholders.mjs dist --report && html-validate \"dist/**/*.html\" && node scripts/check-budgets.mjs dist",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "notebook": "scripts/publish-notebook.sh",
    "baselines": "scripts/update-baselines.sh"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.7",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "astro": "7.4.10",
    "rehype-raw": "7.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "html-validate": "11.21.0",
    "rehype-stringify": "10.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
