{
  "ci": {
    "collect": {
      "startServerCommand": "node tests/serve.mjs",
      "startServerReadyPattern": "serving dist/",
      "url": ["http://localhost:4321/", "http://localhost:4321/about/", "http://localhost:4321/notebooks/", "http://localhost:4321/notebooks/einops-basics/", "http://localhost:4321/404.html"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
