---
import SiteNav from "../components/SiteNav.astro";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/print.css";

interface Props {
  /** Full <title>; plain text. */
  title: string;
  /** Meta and Open Graph description: Nathan's words (or a marker). */
  description: string;
  /** Canonical path, with a trailing slash. */
  path: string;
  /** Font files (built URLs) to preload, for pages whose first screen would
   *  otherwise shift when they swap in. */
  preloadFonts?: string[];
}

const { title, description, path, preloadFonts = [] } = Astro.props;
const canonical = new URL(path, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main" class="page">
      <slot />
    </main>
  </body>
</html>

<style>
  .page {
    max-width: calc(var(--measure) + 2 * var(--space-4));
    margin: 0 auto;
    padding: var(--space-6) var(--space-4) var(--space-6);
  }

  .skip-link {
    position: absolute;
    left: var(--space-3);
    top: calc(-1 * var(--space-6));
    font-family: var(--font-ui);
    font-size: var(--step--1);
    background: var(--color-bg);
    padding: var(--space-2) var(--space-3);
  }

  .skip-link:focus-visible {
    top: var(--space-3);
  }

  @media (max-width: 40rem) {
    .page {
      padding-top: var(--space-5);
    }
  }
</style>
