---
import { getEntry, render } from "astro:content";
import Timeline from "../../components/Timeline.astro";
import Base from "../../layouts/Base.astro";

const about = await getEntry("about", "about");
if (!about) throw new Error("src/content/pages/about.md is missing");
const { Content } = await render(about);
const { description, resume, timeline } = about.data;
---

<Base title="About · Nathan Douglas" description={description} path="/about/">
  <h1>About</h1>
  <div class="prose"><Content /></div>
  <Timeline entries={timeline} />
  <p class="resume"><a href={resume}>Résumé (PDF)</a> · <a href="/about.md">Markdown</a> · <a href="/about.txt">Plain text</a></p>
</Base>

<style>
  .resume {
    margin-top: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>
