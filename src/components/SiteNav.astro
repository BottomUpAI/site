---
// "Research" and "Work" join once those pages have something on them (spec §4).
const items = [{ label: "About", href: "/about/" }];
const current = Astro.url.pathname;
---

<header class="site-nav">
  <nav aria-label="Site">
    <a class="home" href="/">Nathan Douglas</a>
    <ul>
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={current === item.href ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    border-bottom: 1px solid var(--color-rule);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    max-width: calc(var(--measure) + 2 * var(--space-4));
    margin: 0 auto;
    padding: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }

  ul {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a,
  a:visited {
    color: var(--color-fg);
    text-decoration: none;
  }

  a:hover,
  a[aria-current="page"] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home {
    font-weight: 600;
  }
</style>
