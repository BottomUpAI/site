---
import type { TimelineEntry } from "../lib/schemas";
import Text from "./Text.astro";

interface Props {
  entries: TimelineEntry[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <ol class="timeline">
      {entries.map((entry) => (
        <li>
          <time datetime={entry.date}>{entry.date}</time>
          <div>
            <p class="title">
              {entry.href ? (
                <a href={entry.href}>
                  <Text value={entry.title} />
                </a>
              ) : (
                <Text value={entry.title} />
              )}
            </p>
            {entry.detail && (
              <p class="detail">
                <Text value={entry.detail} />
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .timeline {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    max-width: var(--measure);
  }

  li {
    display: grid;
    grid-template-columns: 7.5ch 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--color-rule);
    font-size: var(--step--1);
  }

  p {
    margin: 0;
  }

  .detail {
    margin-top: var(--space-1);
    color: var(--color-muted);
  }

  /* The body lets text break anywhere; a date never should. */
  time {
    font-family: var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
    overflow-wrap: normal;
  }
</style>
